{
  "name": "playwriteproject",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "Regression": "npx playwright test tests",
    "WebTests": "npx playwright test --grep @Web",
    "APITests": "npx playwright test --grep @API",
    "Smoke": "npx playwright test --grep @Smoke",
    "Safari": "npx playwright test tests --config playwright.config1.js --project=Safari",
    "Chrome": "npx playwright test tests --config playwright.config1.js --project=Chrome",
    "CucumberRegression": "npx cucumber-js features --tags \"@Regression\" --retry 1 --format html:cucumber-report.html --exit"
  },
