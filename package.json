  "devDependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/playwright": "^1.1.2",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.14.1",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "exceljs": "^4.4.0"
  }
